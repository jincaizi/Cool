<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>KcpServer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Assets\Scripts\AOT\Protocol\**\*.cs" />
    <!-- 共享 SyncCore（与客户端 asmdef 同批源文件）——T3 接线：应用工程编译共享校验规则 -->
    <Compile Include="..\Assets\Scripts\Hotfix\GameSystems\SyncCore\**\*.cs" />
    <!-- 默认 glob 会误吞子目录测试工程（测试文件引用 xunit，应用工程未引用），显式剔除 -->
    <Compile Remove="Server.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Kcp" Version="2.7.0" />
    <PackageReference Include="protobuf-net" Version="3.2.56" />
  </ItemGroup>

</Project>