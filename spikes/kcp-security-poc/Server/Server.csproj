<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>KcpSecurityPoc.Server</AssemblyName>
    <RootNamespace>KcpSecurityPoc</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\native\win-x64\noise.dll" Link="noise.dll"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\native\win-x64\noise.dll')" />
  </ItemGroup>

</Project>
